FROM golang:1.26-bookworm AS builder

# The MCP RA-TLS v2 transport builds on upstream Go; it needs the sibling
# ra-tls-clients module that go.mod replaces to ../ra-tls-clients/go.
# Keep the pin in sync with .github/workflows/build.yml (an RA-TLS v2 commit).
ARG RA_TLS_CLIENTS_REF=c6c63216dc5a0915569826e3ba2c1efdf44de6b0
RUN git clone https://github.com/Privasys/ra-tls-clients /ra-tls-clients  && git -C /ra-tls-clients checkout "${RA_TLS_CLIENTS_REF}"
ENV GOTOOLCHAIN=local

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# COMMIT_SHA / BUILD_VERSION stamp the binary's build provenance (exposed
# on /healthz). Passed by CI (build.yml); empty on local builds.
ARG COMMIT_SHA=
ARG BUILD_VERSION=
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/privasys/confidential-ai/internal/handler.BuildCommit=${COMMIT_SHA} -X github.com/privasys/confidential-ai/internal/handler.BuildVersion=${BUILD_VERSION}" -o /confidential-ai ./cmd/server/

# ---

# Use the CUDA *devel* image (not runtime) so that vLLM 0.21.0's
# flashinfer-python dependency can JIT-compile its sampling kernels
# at first inference. flashinfer ships a prebuilt wheel but lazily
# generates additional kernel variants via nvcc at runtime, and those
# need:
#   - nvcc                          (cuda-nvcc-12-6)
#   - curand.h, cublas.h, ...        (libcurand-dev, libcublas-dev, ...)
#   - cudart development headers     (cuda-cudart-dev-12-6)
# rather than play whack-a-mole with -dev packages on top of the
# runtime image, switching to -devel pulls the full CUDA 12.6 toolkit
# (matches our runtime version) in one go.
# Cost: image ~3 GB larger; unavoidable until flashinfer ships fully
# precompiled kernels for the variants vLLM 0.21.0 enables by default
# (FlashInfer top-k/top-p sampler).
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

# vLLM v0.28.0 — one release past v0.27.1. What we upgrade FOR: the
# Qwen3.5/3.6 GDN decode path keeps improving (fused CUDA post-conv MTP
# decode kernel #51674, GDN gates aligned with speculative tokens
# #51812) and Mamba prefix caching is now on by DEFAULT (#50991),
# graduating the hybrid-cache work we adopted at 0.27.1.
#
# ⚠ BREAKING (client-visible): `reasoning_content` is GONE from chat
# output — vLLM emits only `reasoning` (#50624, after the rename in
# #33402). Input still accepts both. This fails SILENTLY: a client
# reading delta.reasoning_content just sees nothing and loses the whole
# chain of thought. Our own consumers were audited at this bump —
# chat-stream.ts and the agent loop already read
# `reasoning_content ?? reasoning`; the harness's dsh adapter did not,
# and gained the same fallback (harness overlay, same commit window).
# Anything else written against our /v1 surface needs that fallback.
#
# Removed args (#49389 calculate_kv_scales, #48684
# override_attention_dtype) we never emitted. The default
# max_num_batched_tokens rose 8192 -> 16384 (#51726) but buildVLLMArgs
# always passes an explicit value, so deployments are unaffected.
# Flag audit 2026-09-04: all 20 flags buildVLLMArgs emits still exist at
# this tag (arg_utils.py + openai/cli_args.py).
# Release: https://github.com/vllm-project/vllm/releases/tag/v0.28.0
# Recipe:  https://docs.vllm.ai/projects/recipes/en/latest/Qwen/Qwen3.5.html
#
# CUDA pinning: vLLM publishes two x86_64 GPU wheels per release on
# GitHub: the default (built against CUDA 13, references libcudart.so.13)
# and an explicit `+cu129` wheel (built against CUDA 12.9, references
# libcudart.so.12). Our base image ships the CUDA 12.6 runtime and we
# want to stay on CUDA 12.x, so we install the +cu129 wheel directly
# from the GitHub release and pair it with the cu129 PyTorch backend
# (binary-compatible with the cu126 base — torch ships its own bundled
# libcudart.so.12). Installing plain `vllm==0.28.0` resolves to the
# CUDA 13 default wheel and crashes at import with
# `ImportError: libcudart.so.13: cannot open shared object file`.

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev python3-pip ca-certificates curl \
    gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

ENV UV_BREAK_SYSTEM_PACKAGES=1

# flashinfer-cubin (a hard dep of flashinfer-python >= 0.6.14) is not on
# PyPI; vLLM's own requirements/cuda.txt resolves it from the FlashInfer
# wheel index, so we must pass the same extra index here.
#
# flashinfer-jit-cache ships the PRE-COMPILED kernel variants that
# flashinfer would otherwise nvcc-JIT at first inference (~66 .cu files,
# ~8 min on our H100 — the cold-start that blew the 25-min generate
# readiness cap on 2026-08-08). Pinned by exact wheel URL (per-CUDA
# build, matching flashinfer-python==0.6.16.post3 from vLLM's
# requirements) so the kernel set is part of the image digest.
RUN pip3 install --no-cache-dir --break-system-packages uv && \
    uv pip install --system --torch-backend=cu129 \
      --extra-index-url https://flashinfer.ai/whl/ \
      "https://github.com/vllm-project/vllm/releases/download/v0.28.0/vllm-0.28.0+cu129-cp38-abi3-manylinux_2_28_x86_64.whl" \
      "https://github.com/flashinfer-ai/flashinfer/releases/download/v0.6.16.post3/flashinfer_jit_cache-0.6.16.post3+cu129-cp39-abi3-manylinux_2_28_x86_64.whl"

# Disable vLLM's unconditional Qwen Triton warmup (still present and
# still unconditional at 0.28.0 — the assert below is the tripwire)
# (vllm/model_executor/warmup/qwen_triton_warmup.py). On the H100 TDX
# deployment its synthetic GDN shapes hang a kernel launch: two 45-min
# load attempts died inside it with zero progress (m4/cai-next,
# 2026-08-25) while the engine's own profiling forward pass — which runs
# the same GDN layers on real shapes — completed in ~13 s. Neutering the
# entry point restores the 0.22.1 behavior (kernels JIT lazily on first
# request, cached under TRITON_CACHE_DIR on /data). Appending an override
# rebinds the module attribute before any caller imports it. Revisit when
# upstream makes the warmup optional or fixes the hang.
RUN python3 - <<'PYEOF'
import pathlib
p = pathlib.Path("/usr/local/lib/python3.12/dist-packages/vllm/model_executor/warmup/qwen_triton_warmup.py")
src = p.read_text()
assert "def qwen_triton_warmup(" in src, "warmup entry not found - vLLM layout changed"
src += (
    "\n\n# privasys: warmup disabled - synthetic GDN shapes hang on H100 CC (2026-08-25)\n"
    "def qwen_triton_warmup(runner, model_config):  # noqa: F811\n"
    "    logger.info(\"Qwen Triton warmup disabled by privasys build; kernels JIT lazily.\")\n"
)
p.write_text(src)
print("qwen_triton_warmup neutered")
PYEOF

# Bake the official Gemma 4 chat template into the image so the
# manager can reference it by short name (--chat-template gemma4
# resolves here). Pinned to the exact vLLM release tag for
# reproducibility.
RUN mkdir -p /opt/vllm-templates && \
    curl -fsSL -o /opt/vllm-templates/tool_chat_template_gemma4.jinja \
      https://raw.githubusercontent.com/vllm-project/vllm/v0.28.0/examples/tool_chat_template_gemma4.jinja

COPY --from=builder /confidential-ai /usr/local/bin/confidential-ai
COPY scripts/entrypoint.sh /opt/confidential-ai/entrypoint.sh
RUN chmod +x /opt/confidential-ai/entrypoint.sh

# Model disks: GCP persistent disks are auto-mounted at /mnt/model-* by
# systemd. Bind-mount the whole /mnt into the container so the models
# manager can discover and load any available model on-demand.
LABEL ai.privasys.volume="/mnt:/models:ro"

# GPU passthrough: this image declares the NVIDIA device nodes it needs, so
# the manager passes them through (and enables CDI driver injection) on any
# deploy without per-deploy configuration, mirroring the volume label above.
LABEL ai.privasys.devices="/dev/nvidia0,/dev/nvidiactl,/dev/nvidia-uvm,/dev/nvidia-uvm-tools"

# Dynamic model loading mode: Go proxy starts immediately, vLLM on-demand.
ENV MODELS_DIR=/models
# Pin the version reported in reproducibility metadata to the wheel
# actually installed above. entrypoint.sh and config.go carry the same
# value as a fallback, but this env is the source of truth — the
# per-response `reproducibility.vllm_version` field must agree with
# the wheel. (The running server is always correct — vLLM's
# system_fingerprint comes from the wheel itself — but our attestation
# metadata must match it.)
ENV VLLM_VERSION=0.28.0
ENV CUDA_VERSION=12.6.3

# Disable DeepGEMM FP8 JIT path. vLLM v0.21.0+ ships bundled DeepGEMM
# kernels that JIT-compile via nvcc at first inference for native FP8
# models (e.g. Qwen3.6-35B-A3B-FP8) on Hopper. With the CUDA 12.6
# devel toolkit baked in, the JIT compile aborts with:
#   "Assertion error ... false and 'NVCC compilation failed'"
#   (vllm/utils/deep_gemm.py:295 fp8_gemm_nt -> third_party/deep_gemm).
# Until we ship a vetted DeepGEMM build (or vLLM ships prebuilt FP8
# kernels for the variants it enables by default), force vLLM to use
# its CUTLASS/Triton FP8 backends instead, which work out of the box.
# Cost: ~10–20% throughput on FP8 MoE; correctness unchanged.
# Deliberately KEPT for the 0.28.0 roll (both envs still honored at
# that tag): a 5-version engine bump is not the moment to also change
# the FP8 kernel provider. Re-evaluate separately once 0.28.0 soaks.
ENV VLLM_USE_DEEP_GEMM=0
ENV VLLM_MOE_USE_DEEP_GEMM=0

# 8000 is vLLM's fixed in-container port. The proxy binds the platform-injected
# $PORT (no fixed port); host networking ignores EXPOSE anyway.
EXPOSE 8000

ENTRYPOINT ["/opt/confidential-ai/entrypoint.sh"]
